# Only build inputs enter either image. New local files stay excluded.
*
!pyproject.toml
!uv.lock
!README.md
!alembic.ini
!src/
!src/**
!mocks/
!mocks/pyproject.toml
!mocks/src/
!mocks/src/**
!migrations/
!migrations/**
!config/
!config/**
!fixtures/
!fixtures/tasks.json

# Re-exclude generated and private files inside allowed directories.
**/__pycache__
**/*.py[cod]
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.crt
**/*.local.toml
